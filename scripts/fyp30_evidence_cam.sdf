<?xml version="1.0"?>
<sdf version="1.6">
  <model name="evidence_cam">
    <static>true</static>
    <!-- Overview camera: near-vertical view of the WHOLE room from 12.5 m.
         The room interior spans x -9.4..8.6, y -3.0..17.7 (floor center
         -0.43,7.37), so a cam at (-0.4,-0.5,12.5) pitched -83 deg south-west
         sees the full obstacle field + walls in one frame. -->
    <pose>-0.4 -0.5 12.5 0 -1.35 -0.35</pose>
    <link name="link">
      <sensor name="camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>/evidence_cam/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
