<?xml version="1.0" ?>
<!-- fyp_robot — TurtleBot-style differential-drive mobile robot          -->
<!--                                                                      -->
<!-- COMPATIBILITY CONTRACT (verified against simulation.launch.py,       -->
<!-- fyp_realroom30_up.sh, fyp30_demo.sh, nav2_params.yaml):              -->
<!--   * model name `fyp_robot` (bridges, TF names, set_pose teleports,   -->
<!--     pose logger, footprint static TFs all reference it)              -->
<!--   * VelocityControl drive on /cmd_vel (topic + plugin preserved      -->
<!--     verbatim from the predecessors; Nav2 smoother + monitor cmd path)-->
<!--   * OdometryPublisher: /odom 20 Hz odom->base_link (bumped from 3D   -->
<!--     to planar output; frames fyp_robot/base_footprint + base_link    -->
<!--     are re-created outside via static TF as before)                  -->
<!--   * chassis still 0.7 x 0.5 x 0.15 (0.30 m total w/ tower) — Nav2    -->
<!--     footprint 0.7 x 0.5 in nav2_params.yaml stays valid              -->
<!--   * wheel bottom exactly -0.157 below model origin; spawn z=0.30 in  -->
<!--     simulation.launch.py settles the robot ~5 mm above the floor     --><!--   * NEW (visual realism only): rgbd_camera sensor + a translucent    -->
<!--     camera-FOV wedge marker. Perception stays CAMERA-ONLY: the FYP   -->
<!--     pipeline is smartphone camera + MiDaS monocular depth; there is   -->
<!--     intentionally NO LIDAR / laser sensor on this robot. No plugin    -->
<!--     tags are needed for sensors: the WORLD-level Sensors system       -->
<!--     (gz-sim-sensors-system, already in the realroom SDF world)        -->
<!--     renders them. Topics /rgbd_camera/* are NEW sidecars; no          -->
<!--     existing node subscribes them, so nothing upstream can break.    -->
<sdf version="1.9">
  <model name="fyp_robot">

    <pose>0 0 0.25 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>10</mass>
        <pose>-0.05 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.5</ixx>
          <iyy>0.5</iyy>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <!-- main chassis slab: flatten 0.7 x 0.5, keep same block envelope -->
      <!-- for the Nav2 0.7 x 0.5 footprint (collision bottom -0.15)      -->
      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.70 0.50 0.15</size>
          </box>
        </geometry>
      </collision>

      <visual name="chassis_black_shell">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.70 0.50 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.09 0.11 1</ambient>
          <diffuse>0.10 0.11 0.13 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>

      <!-- TurtleBot3-Waffle style white top plate:                       -->
      <visual name="sensor_deck">
        <pose>-0.02 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.60 0.42 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.82 0.83 0.86 1</ambient>
          <diffuse>0.90 0.91 0.94 1</diffuse>
          <specular>0.18 0.18 0.20 1</specular>
        </material>
      </visual>

      <!-- circular sensor bump (Waffle tower) carrying the RGBD camera:  -->
      <visual name="sensor_bump">
        <pose>0.02 0 0.15 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.065</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.57 0.60 1</ambient>
          <diffuse>0.68 0.70 0.74 1</diffuse>
          <specular>0.35 0.35 0.35 1</specular>
        </material>
      </visual>

      <!-- nav-status LED strip (green front bar, reduces)                -->
      <visual name="front_strip">
        <pose>0.36 0 0.04 0 0 0</pose>
        <geometry>
          <box>
            <size>0.01 0.40 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.10 0.45 0.15 1</ambient>
          <diffuse>0.18 0.75 0.25 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
    </link>

    <!-- ================================================================= -->
    <!-- DRIVE WHEELS (high-grip: friction 1.1)                            -->
    <!-- ================================================================= -->

    <link name="left_wheel">
      <pose>-0.08 0.28 -0.1075 1.5708 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.1</mu>
              <mu2>1.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.045 0.045 0.05 1</ambient>
          <diffuse>0.06 0.06 0.07 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <!-- Light hubcrasp against tyre for a machined rim look:           -->
      <visual name="hub">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.075</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.55 0.12 1</ambient>
          <diffuse>0.85 0.65 0.15 1</diffuse>
          <specular>0.55 0.55 0.55 1</specular>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>-0.08 -0.28 -0.1075 1.5708 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.1</mu>
              <mu2>1.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="tire">
        <geometry>
          <cylinder>
            <radius>0.075</radius>
            <length>0.07</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.045 0.045 0.05 1</ambient>
          <diffuse>0.06 0.06 0.07 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <visual name="hub">
        <geometry>
          <cylinder>
            <radius>0.045</radius>
            <length>0.075</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.72 0.55 0.12 1</ambient>
          <diffuse>0.85 0.65 0.15 1</diffuse>
          <specular>0.55 0.55 0.55 1</specular>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <!-- ================================================================= -->
    <!-- SENSORS (visual realism; camera-based ONLY — no LIDAR)            -->
    <!-- ================================================================= -->

    <!-- Depth+RGB camera (TurtleBot-style front depth cam)               -->
    <link name="rgbd_camera">
      <pose>0.31 0 0.10 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="camera_viz">
        <pose>0.04 -0.03 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.03 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.35 0.12 0.12 1</ambient>
          <diffuse>0.45 0.15 0.15 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
      <visual name="camera_viz_body">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.32 0.36 0.40 1</ambient>
          <diffuse>0.42 0.47 0.52 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
      <sensor name="rgbd" type="rgbd_camera">
        <pose>0.04 0 0 0 0 0</pose>
        <topic>/rgbd_camera</topic>
        <update_rate>15</update_rate>
        <gz_frame_id>rgbd_camera_optical</gz_frame_id>
        <!-- NEAR vision visualization: like the reference image, the -->
        <!-- camera's real rendered point cloud is shown in the GUI as -->
        <!-- the sensor's blue point-cookie. CAMERA-ONLY perception    -->
        <!-- (MiDaS smartphone depth): no lidar/laser anywhere.        -->
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>8</far>
          </clip>
          <depth_camera>
            <output>points</output>
          </depth_camera>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="rgbd_joint" type="fixed">
      <parent>base_link</parent>
      <child>rgbd_camera</child>
    </joint>

    <!-- Camera-FOV removed (looked submarine-like from close-up cams).
         The smartphone camera direction is still verifiable via the
         rgbd sensor topic; the deck cylinder marks its mount. -->

    <!-- ================================================================= -->
    <!-- CASTERS (4-point support as before: front + rear)                 -->
    <!-- ================================================================= -->

    <link name="caster">
      <!-- z chosen so the caster bottom (-0.157 from base origin) matches
           the wheel bottoms, keeping the chassis level instead of tipping -->
      <pose>-0.25 0 -0.1175 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="ball">
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.28 0.28 0.30 1</diffuse>
          <specular>0.60 0.60 0.60 1</specular>
        </material>
      </visual>
      <visual name="mount">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.08 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.09 0.11 1</ambient>
          <diffuse>0.10 0.11 0.13 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <link name="front_caster">
      <pose>0.25 0 -0.1175 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.05</mu>
              <mu2>0.05</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="ball">
        <geometry>
          <sphere>
            <radius>0.04</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.20 0.20 0.22 1</ambient>
          <diffuse>0.28 0.28 0.30 1</diffuse>
          <specular>0.60 0.60 0.60 1</specular>
        </material>
      </visual>
      <visual name="mount">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <box>
            <size>0.08 0.08 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.09 0.11 1</ambient>
          <diffuse>0.10 0.11 0.13 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>
      </visual>
    </link>

    <joint name="front_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster</child>
    </joint>

    <!-- ================================================================= -->
    <!-- DRIVE (preserved verbatim from the original robot)                -->
    <!-- ================================================================= -->

    <!-- Direct velocity control drive (replaces friction-based DiffDrive).
         Wheel-contact friction became unreliable on this machine (commands
         produced ~10% physical motion); VelocityControl applies cmd_vel
         directly to the body, so commanded motion is physically real while
         obstacle contacts still block the robot normally. -->
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- Odometry derived from the robot's TRUE world pose (no wheel
         integration), so odom can never diverge from physical motion. -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <child_frame_id>base_link</child_frame_id>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>

  </model>
</sdf>
