<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="fyp_robot">

    <pose>0 0 0.25 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.5</ixx>
          <iyy>0.5</iyy>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.7 0.5 0.3</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.7 0.5 0.3</size>
          </box>
        </geometry>
      </visual>
    </link>

    <link name="left_wheel">
      <pose>0 0.32 -0.12 1.5708 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.32 -0.12 1.5708 0 0</pose>
      <inertial>
        <mass>1</mass>
        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.01</damping>
        </dynamics>
      </axis>
    </joint>

    <link name="caster">
      <!-- z chosen so the caster bottom (-0.28 from base origin) matches the
           wheel bottoms, keeping the chassis level instead of tipping back. -->
      <pose>-0.25 0 -0.20 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.1</mu>
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
      </visual>
    </link>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <!-- Front caster: with VelocityControl the drive force acts at the COM,
         which pitched the body nose-down into the floor (support was only
         wheels + rear caster). A 4-point support keeps the body flat. -->
    <link name="front_caster">
      <pose>0.25 0 -0.20 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.1</mu>
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.08</radius>
          </sphere>
        </geometry>
      </visual>
    </link>

    <joint name="front_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_caster</child>
    </joint>

    <!-- Direct velocity control drive (replaces friction-based DiffDrive).
         Wheel-contact friction became unreliable on this machine (commands
         produced ~10% physical motion); VelocityControl applies cmd_vel
         directly to the body, so commanded motion is physically real while
         obstacle contacts still block the robot normally. -->
    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>

    <!-- Odometry derived from the robot's TRUE world pose (no wheel
         integration), so odom can never diverge from physical motion. -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <child_frame_id>base_link</child_frame_id>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>
