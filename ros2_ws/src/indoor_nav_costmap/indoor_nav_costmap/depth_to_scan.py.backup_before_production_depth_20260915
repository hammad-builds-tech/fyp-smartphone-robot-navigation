import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image, LaserScan
from cv_bridge import CvBridge
import numpy as np


class DepthToScan(Node):

    def __init__(self):
        super().__init__("depth_to_scan")

        self.bridge = CvBridge()

        self.declare_parameter("depth_topic", "/smartphone/depth")
        self.declare_parameter("scan_topic", "/scan")

        depth_topic = self.get_parameter(
            "depth_topic"
        ).get_parameter_value().string_value

        scan_topic = self.get_parameter(
            "scan_topic"
        ).get_parameter_value().string_value

        self.sub = self.create_subscription(
            Image,
            depth_topic,
            self.depth_callback,
            10,
        )

        self.pub = self.create_publisher(
            LaserScan,
            scan_topic,
            10,
        )

        self.get_logger().info(
            f"DepthToScan started: {depth_topic} -> {scan_topic}"
        )

    def depth_callback(self, msg):

        try:
            depth = self.bridge.imgmsg_to_cv2(
                msg,
                desired_encoding="passthrough",
            )

            depth = np.asarray(depth, dtype=np.float32)

            if depth.ndim != 2:
                return

            h, w = depth.shape

            # Use the horizontal camera field of view.
            # Ignore extreme left/right image regions.
            x1 = int(w * 0.10)
            x2 = int(w * 0.90)

            roi = depth[:, x1:x2]

            # Robust vertical aggregation.
            # Central image rows are more useful for ground-level obstacles.
            y1 = int(h * 0.20)
            y2 = int(h * 0.85)

            roi = roi[y1:y2, :]

            scan_depth = np.nanmedian(roi, axis=0)

            valid = scan_depth[np.isfinite(scan_depth)]

            if valid.size < 10:
                return

            # MiDaS output is relative depth.
            # Convert the relative values into a stable pseudo-range.
            low = float(np.percentile(valid, 5))
            high = float(np.percentile(valid, 95))

            span = max(high - low, 1.0)

            normalized = (scan_depth - low) / span
            normalized = np.clip(normalized, 0.0, 1.0)

            # Low MiDaS value = near.
            # Map near -> 0.35 m and far -> 3.0 m.
            ranges = 0.35 + normalized * 2.65

            ranges[~np.isfinite(ranges)] = 3.0
            ranges = np.clip(ranges, 0.15, 3.0)

            # Downsample to keep Nav2 lightweight.
            target_beams = 120

            if len(ranges) > target_beams:
                indices = np.linspace(
                    0,
                    len(ranges) - 1,
                    target_beams,
                    dtype=np.int32,
                )
                ranges = ranges[indices]

            scan = LaserScan()

            scan.header.stamp = self.get_clock().now().to_msg()
            scan.header.frame_id = "base_link"

            scan.angle_min = -1.0471976
            scan.angle_max = 1.0471976

            if len(ranges) > 1:
                scan.angle_increment = (
                    scan.angle_max - scan.angle_min
                ) / (len(ranges) - 1)
            else:
                scan.angle_increment = 0.0

            scan.time_increment = 0.0
            scan.scan_time = 0.1

            scan.range_min = 0.15
            scan.range_max = 3.0

            scan.ranges = ranges.tolist()

            self.pub.publish(scan)

        except Exception as e:
            self.get_logger().warning(
                f"DepthToScan error: {e}"
            )


def main(args=None):

    rclpy.init(args=args)

    node = DepthToScan()

    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
